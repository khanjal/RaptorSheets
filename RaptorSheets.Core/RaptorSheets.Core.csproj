<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="pack.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
    <PackageIcon>icon.png</PackageIcon>
    <PackageId>RaptorSheets.Core</PackageId>
    <Authors>Iron Raptor Digital</Authors>
    <Description>Core library for RaptorSheets - Google Sheets API integration and utilities.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/khanjal/RaptorSheets</RepositoryUrl>
  <PackageProjectUrl>https://www.raptorsheets.com</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RaptorSheets.Core.Tests" />
    <!--
      Each domain's own SheetHelpers class calls SheetRegistry<TEntity>'s Google-typed members
      (MapData/CheckUnknownSheets/CheckSheetHeaders/GetMissingSheets/DetectMissingColumns) through
      its own private registry field. Those members are internal - Google.Apis.Sheets.v4 types are
      Core's implementation detail, not part of the public contract - so the four domain assemblies
      need explicit access to keep compiling. This is narrower than it looks: it grants access to
      everything internal in Core, but nothing outside these five projects can reach it.
    -->
    <InternalsVisibleTo Include="RaptorSheets.Gig" />
    <InternalsVisibleTo Include="RaptorSheets.Stock" />
    <InternalsVisibleTo Include="RaptorSheets.Job" />
    <InternalsVisibleTo Include="RaptorSheets.Home" />
    <!--
      Each domain's own test suite exercises Core-declared-but-internal manager members
      (GetSpreadsheetInfo/GetBatchData, inherited from SheetManagerBase<TEntity>) directly on that
      domain's concrete manager. InternalsVisibleTo isn't transitive - granting Gig access above
      doesn't extend to Gig.Tests, since the member's accessibility is checked against Core (where
      it's declared), not Gig (where it's inherited) - same reasoning Core.Tests already relies on
      for Core's own internals above.
    -->
    <InternalsVisibleTo Include="RaptorSheets.Gig.Tests" />
    <InternalsVisibleTo Include="RaptorSheets.Stock.Tests" />
    <InternalsVisibleTo Include="RaptorSheets.Job.Tests" />
    <InternalsVisibleTo Include="RaptorSheets.Home.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.73.0.4112" />
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.73.0.4061" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
  </ItemGroup>

</Project>
