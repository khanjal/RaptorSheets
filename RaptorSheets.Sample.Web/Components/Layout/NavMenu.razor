@using RaptorSheets.Sample.Web.Services
@inject DomainRegistry Domains

<nav>
    <div class="brand">RaptorSheets Sample</div>

    @foreach (var domain in Domains.Domains)
    {
        <div class="domain-group">
            <div class="domain-label">@domain.DomainLabel</div>
            <ul>
                @foreach (var sheetName in GetSheetNames(domain))
                {
                    <li>
                        <NavLink href="@BuildHref(domain.DomainName, sheetName)">@sheetName</NavLink>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="nav-footer">
        <NavLink href="settings">Settings</NavLink>
    </div>
</nav>

@code {
    private static IEnumerable<string> GetSheetNames(ISheetOperations domain) =>
        SheetMetadata.GetSheetDescriptors(domain.SheetsType, domain.SheetNamesType)
            .Select(d => d.Name)
            .Where(name => !domain.ExcludedSheetNames.Contains(name));

    // Sheet names aren't always URL-safe as-is - Job/Home have names with spaces and "&"
    // (e.g. "Interview Types", "Doors & Windows").
    private static string BuildHref(string domainName, string sheetName) =>
        $"sheet/{domainName}/{Uri.EscapeDataString(sheetName)}";
}
