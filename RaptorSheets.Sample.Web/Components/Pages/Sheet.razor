@page "/sheet/gig/{SheetName}"
@using System.Collections
@using RaptorSheets.Core.Entities
@using RaptorSheets.Core.Utilities
@using RaptorSheets.Gig.Constants
@using RaptorSheets.Gig.Entities
@using RaptorSheets.Gig.Managers
@using RaptorSheets.Sample.Web.Services
@inject GigConnectionProvider ConnectionProvider

<PageTitle>@SheetName - RaptorSheets Sample</PageTitle>

<h1>@SheetName</h1>

@if (_error is not null)
{
    <p class="setup-message">@_error</p>
}
else if (_notFoundOnSheet)
{
    <p>The "@SheetName" sheet doesn't exist yet on this spreadsheet.</p>
    <button @onclick="CreateSheetAsync" disabled="@_isBusy">Create "@SheetName" sheet</button>
}
else if (_gridType is not null && _gridParameters is not null)
{
    <DynamicComponent Type="_gridType" Parameters="_gridParameters" />
}
else
{
    <p>Loading...</p>
}

@if (_messages.Count > 0)
{
    <ul class="messages">
        @foreach (var message in _messages)
        {
            <li class="@message.Level.ToLowerInvariant()">@message.Message</li>
        }
    </ul>
}

@code {
    [Parameter]
    public string SheetName { get; set; } = string.Empty;

    private IGoogleSheetManager? _manager;
    private SheetDescriptor? _descriptor;
    private Type? _gridType;
    private Dictionary<string, object>? _gridParameters;
    private List<MessageEntity> _messages = [];
    private string? _error;
    private bool _notFoundOnSheet;
    private bool _isBusy;
    private int _loadGeneration;

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _notFoundOnSheet = false;
        _gridType = null;
        _gridParameters = null;
        _messages = [];

        if (!ConnectionProvider.TryGetManager(out var manager, out var connectionError))
        {
            _error = connectionError;
            return;
        }

        _manager = manager;
        _descriptor = SheetMetadata.GetSheetDescriptors(typeof(GigSheets))
            .FirstOrDefault(d => string.Equals(d.Name, SheetName, StringComparison.OrdinalIgnoreCase));

        if (_descriptor is null)
        {
            _error = $"\"{SheetName}\" isn't a known Gig sheet.";
            return;
        }

        await LoadAsync();
    }

    // Which reference sheet backs the dropdown for a given [Column]'s ValidationPattern - mirrors
    // Gig's own (internal) GigSheetHelpers.GetSheetForRange, built from the same public constants
    // since that mapping isn't itself public.
    private static readonly Dictionary<string, string> ValidationSheetMap = new()
    {
        [SheetsConfig.ValidationNames.RangeAddress] = SheetsConfig.SheetNames.Addresses,
        [SheetsConfig.ValidationNames.RangeName] = SheetsConfig.SheetNames.Names,
        [SheetsConfig.ValidationNames.RangePlace] = SheetsConfig.SheetNames.Places,
        [SheetsConfig.ValidationNames.RangeRegion] = SheetsConfig.SheetNames.Regions,
        [SheetsConfig.ValidationNames.RangeService] = SheetsConfig.SheetNames.Services,
        [SheetsConfig.ValidationNames.RangeType] = SheetsConfig.SheetNames.Types,
    };

    private async Task LoadAsync()
    {
        var generation = ++_loadGeneration;
        _isBusy = true;
        try
        {
            var tabNames = await _manager!.GetAllSheetTabNames();
            if (!tabNames.Contains(_descriptor!.Name, StringComparer.OrdinalIgnoreCase))
            {
                _notFoundOnSheet = true;
                return;
            }

            var isReadOnly = _manager.GetSheetLayout(_descriptor.Name)?.ProtectSheet ?? false;

            // Fast path: just the sheet being viewed, same single read as before dropdowns existed.
            // Reference-sheet data for dropdowns loads separately, in the background, so a big sheet
            // like Trips (thousands of rows) isn't held up by also pulling in six lookup sheets.
            var result = await _manager.GetSheet(_descriptor.Name);
            _messages = result.Messages;

            var rows = _descriptor.GetRows(result.Sheets);

            _gridType = typeof(EntityGrid<>).MakeGenericType(_descriptor.RowType);
            _gridParameters = new Dictionary<string, object>
            {
                ["Rows"] = rows,
                ["OnSaveRequested"] = EventCallback.Factory.Create<IList>(this, SaveAsync),
                ["ReadOnly"] = isReadOnly,
                ["DropdownOptions"] = new Dictionary<string, IReadOnlyList<string>>()
            };
        }
        finally
        {
            _isBusy = false;
        }

        if (!_notFoundOnSheet && _error is null)
        {
            _ = LoadDropdownOptionsAsync(generation);
        }
    }

    private async Task LoadDropdownOptionsAsync(int generation)
    {
        var validatedColumns = TypedFieldUtils.GetColumnProperties(_descriptor!.RowType)
            .Where(c => c.Column.IsInput && c.Column.EnableValidation && c.Column.ValidationPattern is not null)
            .Where(c => ValidationSheetMap.ContainsKey(c.Column.ValidationPattern!))
            .ToList();

        var referenceSheetNames = validatedColumns
            .Select(c => ValidationSheetMap[c.Column.ValidationPattern!])
            .Distinct()
            .ToList();

        if (referenceSheetNames.Count == 0)
        {
            return;
        }

        var result = await _manager!.GetSheets(referenceSheetNames);

        if (generation != _loadGeneration)
        {
            return; // navigated away / reloaded since this started
        }

        var allDescriptors = SheetMetadata.GetSheetDescriptors(typeof(GigSheets));
        var dropdownOptions = new Dictionary<string, IReadOnlyList<string>>();

        foreach (var column in validatedColumns.Select(c => c.Column))
        {
            var refSheetName = ValidationSheetMap[column.ValidationPattern!];
            var refDescriptor = allDescriptors.FirstOrDefault(d => d.Name == refSheetName);
            var refColumns = refDescriptor is null ? [] : TypedFieldUtils.GetColumnProperties(refDescriptor.RowType);
            if (refDescriptor is null || refColumns.Count == 0)
            {
                continue;
            }

            // Every reference entity declares its identity value as its first column
            // (e.g. ServiceEntity.Service, AddressEntity.Address) - see the entities themselves.
            var identityProperty = refColumns[0].Property;
            var options = refDescriptor.GetRows(result.Sheets)
                .Cast<object>()
                .Select(r => identityProperty.GetValue(r)?.ToString())
                .Where(v => !string.IsNullOrWhiteSpace(v))
                .Distinct()
                .OrderBy(v => v, StringComparer.OrdinalIgnoreCase)
                .Cast<string>()
                .ToList();

            dropdownOptions[column.HeaderName] = options;
        }

        if (_gridParameters is not null)
        {
            _gridParameters = new Dictionary<string, object>(_gridParameters)
            {
                ["DropdownOptions"] = dropdownOptions
            };
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task CreateSheetAsync()
    {
        _isBusy = true;
        try
        {
            var result = await _manager!.CreateSheets([_descriptor!.Name]);
            _messages = result.Messages;
            await LoadAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SaveAsync(IList dirtyRows)
    {
        var entity = new SheetEntity();
        _descriptor!.ListProperty.SetValue(entity.Sheets, dirtyRows);

        var result = await _manager!.ChangeSheetData([_descriptor.Name], entity);
        _messages = result.Messages;

        await LoadAsync();
    }
}
