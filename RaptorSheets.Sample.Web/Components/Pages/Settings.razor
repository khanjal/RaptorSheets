@page "/settings"
@using System.Text.Json
@using RaptorSheets.Sample.Web.Services
@inject GigConnectionProvider ConnectionProvider
@inject UserSecretsWriter SecretsWriter

<PageTitle>Settings - RaptorSheets Sample</PageTitle>

<h1>Settings</h1>

<p>
    Credentials and spreadsheet IDs for every domain, all in one place. This is the same secrets
    store <a href="/">the sample app</a> connects with and RaptorSheets.Test's integration suite
    reads - update it here instead of the CLI.
</p>

<section class="settings-section">
    <h2>Credentials</h2>

    @if (_currentClientEmail is not null)
    {
        <p class="status ok">Connected as <code>@_currentClientEmail</code>.</p>
    }
    else
    {
        <p class="status error">No service account configured yet.</p>
    }

    @if (!_showCredentialsForm)
    {
        <button @onclick="OpenCredentialsForm">
            @(_currentClientEmail is null ? "Add credentials" : "Replace credentials")
        </button>
    }
    else
    {
        <label>
            <span>Paste full JSON key to autofill (optional)</span>
            <textarea rows="4" value="@_pasteJson" @oninput="OnPasteJsonInput"
                      placeholder='{ "type": "service_account", "private_key": "...", "client_email": "...", ... } - or just fill in the fields below directly'></textarea>
        </label>
        @if (_pasteError is not null)
        {
            <p class="status error">@_pasteError</p>
        }
        @if (_pasteSucceeded)
        {
            <p class="status ok">Parsed - filled in all 5 fields below.</p>
        }

        <label>
            <span>Type</span>
            <input value="@_credType" @oninput="e => _credType = e.Value?.ToString() ?? string.Empty" />
        </label>
        <label>
            <span>Client email</span>
            <input value="@_credClientEmail" @oninput="e => _credClientEmail = e.Value?.ToString() ?? string.Empty" />
        </label>
        <label>
            <span>Client ID</span>
            <input value="@_credClientId" @oninput="e => _credClientId = e.Value?.ToString() ?? string.Empty" />
        </label>
        <label>
            <span>Private key ID</span>
            <input value="@_credPrivateKeyId" @oninput="e => _credPrivateKeyId = e.Value?.ToString() ?? string.Empty" />
        </label>
        <label>
            <span class="field-label-row">
                Private key
                <button type="button" class="link-button" @onclick="() => _revealSecret = !_revealSecret">
                    @(_revealSecret ? "Hide" : "Show")
                </button>
            </span>
            @if (_revealSecret)
            {
                <textarea rows="8" value="@_credPrivateKey" @oninput="e => _credPrivateKey = e.Value?.ToString() ?? string.Empty"
                          placeholder="-----BEGIN PRIVATE KEY-----..."></textarea>
            }
            else
            {
                <div class="masked-placeholder">
                    @(_credPrivateKey.Length switch
                    {
                        0 when _currentClientEmail is not null => "Left blank - saving keeps the existing private key",
                        0 => "Not entered yet",
                        var n => $"{n} characters entered - click Show to view or edit"
                    })
                </div>
            }
        </label>

        <button type="button" class="link-button" @onclick="CancelCredentialsEdit">Cancel</button>
    }
</section>

<section class="settings-section">
    <h2>Spreadsheet IDs</h2>
    <p class="setup-hint">
        Only Gig is wired up in this sample app's nav today - Stock/Job/Home are here so the
        integration test suite has what it needs too, from the same one place.
    </p>

    <div class="spreadsheet-grid">
        <label>
            <span>Gig</span>
            <input value="@_gigSpreadsheetId" @oninput="e => _gigSpreadsheetId = e.Value?.ToString() ?? string.Empty" />
        </label>
        <label>
            <span>Stock</span>
            <input value="@_stockSpreadsheetId" @oninput="e => _stockSpreadsheetId = e.Value?.ToString() ?? string.Empty" />
        </label>
        <label>
            <span>Job</span>
            <input value="@_jobSpreadsheetId" @oninput="e => _jobSpreadsheetId = e.Value?.ToString() ?? string.Empty" />
        </label>
        <label>
            <span>Home</span>
            <input value="@_homeSpreadsheetId" @oninput="e => _homeSpreadsheetId = e.Value?.ToString() ?? string.Empty" />
        </label>
    </div>
</section>

@if (_message is not null)
{
    <p class="status @(_messageIsError ? "error" : "ok")">@_message</p>
}

<button class="btn-primary" @onclick="SaveAsync" disabled="@_isBusy">@(_isBusy ? "Saving..." : "Save")</button>

@code {
    private string? _currentClientEmail;
    private bool _showCredentialsForm;
    private bool _revealSecret;
    private string _pasteJson = string.Empty;
    private string? _pasteError;
    private bool _pasteSucceeded;
    private string _credType = string.Empty;
    private string _credPrivateKeyId = string.Empty;
    private string _credPrivateKey = string.Empty;
    private string _credClientEmail = string.Empty;
    private string _credClientId = string.Empty;
    private string _gigSpreadsheetId = string.Empty;
    private string _stockSpreadsheetId = string.Empty;
    private string _jobSpreadsheetId = string.Empty;
    private string _homeSpreadsheetId = string.Empty;
    private bool _isBusy;
    private string? _message;
    private bool _messageIsError;

    protected override void OnInitialized() => LoadCurrent();

    private void LoadCurrent()
    {
        var snapshot = SecretsWriter.GetCurrentConfig();
        _currentClientEmail = snapshot.ClientEmail;
        _gigSpreadsheetId = snapshot.GigSpreadsheetId ?? string.Empty;
        _stockSpreadsheetId = snapshot.StockSpreadsheetId ?? string.Empty;
        _jobSpreadsheetId = snapshot.JobSpreadsheetId ?? string.Empty;
        _homeSpreadsheetId = snapshot.HomeSpreadsheetId ?? string.Empty;
    }

    // Prefills everything except the private key, which never comes back down to the browser once
    // saved - leaving it blank here means "keep the existing one" on save (see WriteSettings).
    private void OpenCredentialsForm()
    {
        var snapshot = SecretsWriter.GetCurrentConfig();
        _credType = snapshot.CredentialType ?? "service_account";
        _credPrivateKeyId = snapshot.PrivateKeyId ?? string.Empty;
        _credClientEmail = snapshot.ClientEmail ?? string.Empty;
        _credClientId = snapshot.ClientId ?? string.Empty;
        _credPrivateKey = string.Empty;
        _showCredentialsForm = true;
    }

    private void CancelCredentialsEdit()
    {
        _pasteJson = string.Empty;
        _pasteError = null;
        _pasteSucceeded = false;
        _credType = string.Empty;
        _credPrivateKeyId = string.Empty;
        _credPrivateKey = string.Empty;
        _credClientEmail = string.Empty;
        _credClientId = string.Empty;
        _showCredentialsForm = false;
        _revealSecret = false;
    }

    // Pure UI convenience - parses the pasted key into the individual fields below so a user doesn't
    // have to copy 5 values out of the downloaded JSON by hand. The fields (not this textarea) are
    // what actually gets saved.
    private void OnPasteJsonInput(ChangeEventArgs e)
    {
        _pasteJson = e.Value?.ToString() ?? string.Empty;
        _pasteError = null;
        _pasteSucceeded = false;

        if (string.IsNullOrWhiteSpace(_pasteJson))
        {
            return;
        }

        try
        {
            using var parsed = JsonDocument.Parse(NormalizePrivateKeyLineBreaks(_pasteJson));
            var root = parsed.RootElement;
            var type = GetString(root, "type");
            var privateKeyId = GetString(root, "private_key_id");
            var privateKey = GetString(root, "private_key");
            var clientEmail = GetString(root, "client_email");
            var clientId = GetString(root, "client_id");

            if (type is null && privateKeyId is null && privateKey is null && clientEmail is null && clientId is null)
            {
                _pasteError = "That parsed as JSON, but none of the expected fields (type, private_key_id, " +
                              "private_key, client_email, client_id) were found - is this the whole key file?";
                return;
            }

            _credType = type ?? _credType;
            _credPrivateKeyId = privateKeyId ?? _credPrivateKeyId;
            _credPrivateKey = privateKey ?? _credPrivateKey;
            _credClientEmail = clientEmail ?? _credClientEmail;
            _credClientId = clientId ?? _credClientId;
            _pasteSucceeded = true;
        }
        catch (JsonException ex)
        {
            _pasteError = $"Not valid JSON yet - keep pasting, or fill in the fields below directly. ({ex.Message})";
        }
    }

    // Some editors/viewers "pretty-print" a downloaded key file, turning the private_key's escaped
    // \n sequences into literal line breaks - which makes the surrounding JSON invalid (a raw
    // newline inside a JSON string isn't legal per RFC 8259, so JsonDocument.Parse rejects the
    // *entire* document, not just that field). Re-escape line breaks found between the PEM markers
    // before parsing, since that's specifically where this shows up.
    private static string NormalizePrivateKeyLineBreaks(string input)
    {
        const string beginMarker = "-----BEGIN PRIVATE KEY-----";
        const string endMarker = "-----END PRIVATE KEY-----";

        var beginIndex = input.IndexOf(beginMarker, StringComparison.Ordinal);
        var endIndex = input.IndexOf(endMarker, StringComparison.Ordinal);

        if (beginIndex < 0 || endIndex < 0 || endIndex < beginIndex)
        {
            return input;
        }

        // Extend to the actual closing quote of the JSON string, not just the end marker text -
        // real keys have a trailing line break *between* "-----END PRIVATE KEY-----" and the quote
        // that closes the value, which would otherwise be left outside the captured span and stay
        // an unescaped literal newline.
        var closingQuoteIndex = input.IndexOf('"', endIndex + endMarker.Length);
        if (closingQuoteIndex < 0)
        {
            return input;
        }

        var pemBlock = input[beginIndex..closingQuoteIndex];
        var normalizedPemBlock = pemBlock.Replace("\r\n", "\n").Replace("\n", "\\n");

        return string.Concat(input.AsSpan(0, beginIndex), normalizedPemBlock, input.AsSpan(closingQuoteIndex));
    }

    private static string? GetString(JsonElement root, string property) =>
        root.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.String
            ? value.GetString()
            : null;

    private async Task SaveAsync()
    {
        _isBusy = true;
        _message = null;
        try
        {
            var update = new UserSecretsWriter.SettingsUpdate(
                _showCredentialsForm ? _credType : null,
                _showCredentialsForm ? _credPrivateKeyId : null,
                _showCredentialsForm ? _credPrivateKey : null,
                _showCredentialsForm ? _credClientEmail : null,
                _showCredentialsForm ? _credClientId : null,
                _gigSpreadsheetId,
                _stockSpreadsheetId,
                _jobSpreadsheetId,
                _homeSpreadsheetId);

            var result = SecretsWriter.WriteSettings(update);

            if (!result.Success)
            {
                _message = result.Error;
                _messageIsError = true;
                return;
            }

            CancelCredentialsEdit();
            ConnectionProvider.Reset();
            LoadCurrent();

            var connected = ConnectionProvider.TryGetManager(out _, out var connectionError);
            _message = connected ? "Saved and connected." : $"Saved, but couldn't connect: {connectionError}";
            _messageIsError = !connected;
        }
        finally
        {
            _isBusy = false;
        }
    }
}
