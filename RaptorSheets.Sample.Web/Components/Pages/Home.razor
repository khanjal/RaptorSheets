@page "/"
@using RaptorSheets.Sample.Web.Services
@inject DomainRegistry Domains
@inject ConnectionRegistry Connections

<PageTitle>RaptorSheets Sample</PageTitle>

<h1>RaptorSheets Sample</h1>

<p>
    A runnable UI over the RaptorSheets domain libraries - point it at a real spreadsheet
    and browse, add, edit, and delete rows through the sheets it manages.
</p>

@if (_connected)
{
    <p class="status ok">Connected to the @_ops?.DomainLabel spreadsheet "@_connection?.Label". Pick a sheet from the left to get started.</p>

    @if (_connection?.IsTestFallback == true)
    {
        <p class="status warning">
            No spreadsheet configured yet, so this is showing the shared test dataset RaptorSheets'
            integration tests delete and regenerate on every run - anything added here won't be
            permanent. <a href="/settings">Set your own spreadsheet in Settings</a> to keep what you add.
        </p>
    }
    else
    {
        <p class="setup-hint">
            Have more than one Gig spreadsheet? This page always starts with the first one you added -
            switch, add, or remove connections from <a href="/settings">Settings</a>.
        </p>
    }

    @if (_isBlankSpreadsheet)
    {
        <div class="demo-prompt">
            <p>This spreadsheet doesn't have any @_ops?.DomainLabel sheets on it yet.</p>
            <button class="btn-primary" @onclick="CreateDemoDataAsync" disabled="@_isBusy">
                @(_isBusy ? "Setting up..." : "Create sheets + fill with demo data")
            </button>
            @if (_demoDataMessage is not null)
            {
                <p class="status error">@_demoDataMessage</p>
            }
        </div>
    }
}
else
{
    <p class="status error">@_connectionError</p>
    <p>
        Head to <a href="settings">Settings</a> to connect a spreadsheet - it walks through creating
        a Google Cloud service account and pasting its key in, no CLI needed.
    </p>
}

@code {
    private ISheetOperations? _ops;
    private ITypedConnectedSheet? _sheet;
    private SpreadsheetConnection? _connection;
    private bool _connected;
    private string? _connectionError;
    private bool _isBlankSpreadsheet;
    private bool _isBusy;
    private string? _demoDataMessage;

    protected override async Task OnInitializedAsync()
    {
        _ops = Domains.TryGet("gig");
        await RefreshConnectionStateAsync();
    }

    private async Task RefreshConnectionStateAsync()
    {
        _isBlankSpreadsheet = false;

        if (_ops is null)
        {
            _connected = false;
            _connectionError = "The Gig domain isn't registered.";
            return;
        }

        // First connection found (including the synthesized shared-test-dataset one) - see this
        // page's own setup hint above for why "first" is fine here even with multiple connections.
        _connection = Connections.GetByType(_ops.DomainName).FirstOrDefault();
        if (_connection is null)
        {
            _connected = false;
            _connectionError = "No Gig spreadsheet configured yet.";
            return;
        }

        _connected = _ops.TryConnect(_connection, out _sheet, out _connectionError);

        if (_connected && _sheet is not null)
        {
            var tabNames = await _sheet.GetAllSheetTabNamesAsync();
            var knownSheetNames = SheetMetadata.GetSheetDescriptors(_ops.SheetsType, _ops.SheetNamesType)
                .Select(d => d.Name)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            _isBlankSpreadsheet = !tabNames.Any(knownSheetNames.Contains);
        }
    }

    private async Task CreateDemoDataAsync()
    {
        if (_sheet is null)
        {
            return;
        }

        _isBusy = true;
        _demoDataMessage = null;
        try
        {
            // Safe specifically because this button only ever shows when _isBlankSpreadsheet is
            // true - no Gig sheets exist yet, so there's no real data these fresh sheets could
            // possibly overwrite (see IConnectedSheet.InsertDemoDataAsync for why that's not true
            // in general).
            var createMessages = await _sheet.CreateAllSheetsAsync();
            var createErrors = createMessages.Where(m => string.Equals(m.Level, "ERROR", StringComparison.OrdinalIgnoreCase)).ToList();
            if (createErrors.Count > 0)
            {
                _demoDataMessage = string.Join(" ", createErrors.Select(m => m.Message));
                return;
            }

            var messages = await _sheet.InsertDemoDataAsync();
            var errors = messages.Where(m => string.Equals(m.Level, "ERROR", StringComparison.OrdinalIgnoreCase)).ToList();
            if (errors.Count > 0)
            {
                _demoDataMessage = string.Join(" ", errors.Select(m => m.Message));
                return;
            }

            _isBlankSpreadsheet = false;
        }
        finally
        {
            _isBusy = false;
        }
    }
}
