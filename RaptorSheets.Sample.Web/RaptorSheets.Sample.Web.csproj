<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!--
      Deliberately the same UserSecretsId as RaptorSheets.Test.Common (nothing in the tooling
      requires these to be unique per project - it's just a folder name under
      %APPDATA%/Microsoft/UserSecrets). Both projects want the identical service-account
      credentials, so they share one secrets.json instead of each needing its own copy kept in sync
      by hand. Spreadsheet IDs are NOT shared despite living in the same file: this app's Settings
      page only ever reads/writes spreadsheets:live:{domain} (the user's real data), while
      RaptorSheets.Test.Common's TestConfigurationHelpers only ever reads spreadsheets:test:{domain}
      (a dedicated spreadsheet the integration suite deletes and regenerates every run) - see
      SheetOperationsBase.Connect for the fallback that shows the test data when no live spreadsheet
      is configured yet.
    -->
    <UserSecretsId>d3dcd413-34b9-40ef-9a99-a2615263e431</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaptorSheets.Core\RaptorSheets.Core.csproj" />
    <ProjectReference Include="..\RaptorSheets.Gig\RaptorSheets.Gig.csproj" />
    <ProjectReference Include="..\RaptorSheets.Stock\RaptorSheets.Stock.csproj" />
    <ProjectReference Include="..\RaptorSheets.Job\RaptorSheets.Job.csproj" />
    <ProjectReference Include="..\RaptorSheets.Home\RaptorSheets.Home.csproj" />
  </ItemGroup>

</Project>
